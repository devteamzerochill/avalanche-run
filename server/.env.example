# Copy to server/.env to run the race server on this machine against zerochill.com
# (the fallback in docs/race-from-this-pc.md). Cloud has its own copies of these
# under Settings -> Environment variables. Never commit server/.env.
SUPABASE_URL=
SERVE_GAME=1
PORT=2567

# The race server's own zerochill.com account. The owner fills these in.
RACE_SERVER_EMAIL=
RACE_SERVER_PASSWORD=
